generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  teamId   Int
  team     Team   @relation(fields: [teamId], references: [id])
}

model Team {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}
